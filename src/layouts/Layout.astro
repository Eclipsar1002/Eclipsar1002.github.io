---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter, fade } from 'astro:transitions';
import { getLocaleFromUrl, getSiteConfig, locales, localizePath } from '../config/site';
import '../styles/global.css';
import RainEffect from '../components/RainEffect.astro';
import AppearanceControls from '../components/AppearanceControls.astro';
interface Props {
	title?: string;
	description?: string;
}

const locale = getLocaleFromUrl(Astro.url);
const siteConfig = getSiteConfig(locale);
const { title = siteConfig.name, description = siteConfig.description } = Astro.props;

const pageTitle = title === siteConfig.name ? title : `${title} | ${siteConfig.name}`;
const currentPath = (Astro.url.pathname.replace(/^\/en(?=\/|$)/, '') || '/').replace(/-en(?=\/?$)/, '');
const background = siteConfig.background;
const backgroundImageStyle = [
	`--desktop-background: url("${background.image}")`,
	`--mobile-background: url("${background.mobileImage || background.image}")`,
	`filter: blur(${background.blur}) brightness(${background.brightness})`,
	`opacity: ${background.opacity}`,
	`transform: scale(${background.scale})`,
].join('; ');
---

<!doctype html>
<html lang={locales[locale].lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<link rel="alternate" hreflang="zh-CN" href={localizePath('zh', currentPath)} />
		<link rel="alternate" hreflang="en" href={localizePath('en', currentPath)} />
		<ClientRouter />
		<title>{pageTitle}</title>
	</head>
	<body class="min-h-screen bg-black text-white antialiased">
		<div class="pointer-events-none fixed inset-0 z-0 overflow-hidden" transition:persist="site-background" transition:name="site-background" transition:animate="none">
			<div data-site-background data-default-image={background.image} data-default-mobile-image={background.mobileImage} data-default-brightness={background.brightness} data-default-blur={background.blur} class="absolute inset-0 bg-cover bg-center bg-no-repeat" style={backgroundImageStyle}></div>


			<RainEffect />
		</div>
		<Header />
		<AppearanceControls />
		<main class="relative z-10" transition:name="page-content" transition:animate={fade({ duration: '220ms' })}>
			<slot />
		</main>
		<div class="relative z-10">
			<Footer />
		</div>
	</body>
</html>

<script>
  import type { TransitionBeforePreparationEvent, TransitionBeforeSwapEvent } from 'astro:transitions/client';

  function isSectionList(url: URL) {
    return /^\/(?:en\/)?(?:projects|blog|moments)\/?$/.test(url.pathname);
  }

  function useSectionSlide(event: TransitionBeforePreparationEvent | TransitionBeforeSwapEvent) {
    return isSectionList(event.from) && isSectionList(event.to) &&
      event.from.pathname.replace(/\/$/, '') !== event.to.pathname.replace(/\/$/, '');
  }

  let returningTitle = '';
  document.addEventListener('astro:before-preparation', event => {
    document.documentElement.toggleAttribute('data-entry-title-slide', useSectionSlide(event));
    const detail = event.from.pathname.match(/^(\/(?:en\/)?(?:projects|blog))\/.+/);
    const heading = document.querySelector('main h1');
    returningTitle = detail && heading && event.to.pathname.replace(/\/$/, '') === detail[1]
      ? getComputedStyle(heading).viewTransitionName
      : '';
  });
  document.addEventListener('astro:before-swap', event => {
    event.newDocument.documentElement.toggleAttribute('data-entry-title-slide', useSectionSlide(event));
  });
  document.addEventListener('astro:after-swap', () => {
    if (!returningTitle) return;
    const title = [...document.querySelectorAll<HTMLElement>('.entry-transition-title')]
      .find(element => getComputedStyle(element).viewTransitionName === returningTitle);
    returningTitle = '';
    if (!title) return;
    const bounds = title.getBoundingClientRect();
    const headerBottom = document.querySelector('body > header')?.getBoundingClientRect().bottom || 0;
    if (bounds.top < headerBottom + 16 || bounds.bottom > window.innerHeight - 24) {
      // Set the destination before the new view snapshot, rather than scrolling after the animation.
      title.scrollIntoView({ behavior: 'instant', block: 'center' });
    }
  });
</script>

<style>
  [data-site-background] { background-image: var(--desktop-background); }
  @media (max-width: 767px) {
    [data-site-background] { background-image: var(--mobile-background); }
  }
</style>

