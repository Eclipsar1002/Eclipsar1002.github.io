---
import { DEFAULT_PLAYLIST_ID } from '../lib/meting';
interface Props { playlistId?: string; compact?: boolean }
const { playlistId = DEFAULT_PLAYLIST_ID, compact = true } = Astro.props;
const waveLines = Array.from({ length: 160 }, (_, index) => index * 360 / 160);
---

<div class="music-player" data-music-player data-compact={compact} data-playlist-id={playlistId}>
  <div class="mp-left">
    <p class="mp-kicker">A little soundtrack</p>
    <div class="mp-tabs">
      <button class="mp-mode-btn" data-mode-btn type="button" aria-label="切换播放模式"><span data-mode-label>顺序</span><span aria-hidden="true"> ↻</span></button>
      <button class="mp-quality-btn" data-quality-btn type="button" aria-label="切换音质"><span data-quality-label>标准</span><span aria-hidden="true"> ↗</span></button>
    </div>
    <label class="mp-playlist-label" for="home-playlist">网易云歌单 ID</label>
    <input id="home-playlist" class="mp-playlist-input" data-playlist-input type="text" inputmode="numeric" placeholder="输入歌单 ID，回车切换" autocomplete="off" aria-label="网易云歌单 ID" />
    <div class="mp-meta" aria-live="polite">
      <div class="mp-title" data-title>正在寻找今天的声音…</div>
      <div class="mp-artist" data-artist>—</div>
    </div>
    <div class="mp-controls">
      <button class="mp-btn" data-prev type="button" aria-label="上一首">⏮</button>
      <button class="mp-btn mp-btn-play" data-play type="button" aria-label="播放/暂停"><span data-play-icon>▶</span></button>
      <button class="mp-btn" data-next type="button" aria-label="下一首">⏭</button>
    </div>
  </div>
  <div class="mp-disc" aria-label="当前歌曲封面与播放动效">
    <svg class="mp-spectrum" viewBox="0 0 280 280" aria-hidden="true">
      {waveLines.map((angle) => <line data-wave-line x1="140" y1="41" x2="140" y2="38" transform={`rotate(${angle} 140 140)`} />)}
    </svg>
    <div class="mp-cover"><img data-cover src="/avatar.png" alt="音乐封面" decoding="async" /></div>
  </div>
  <div class="mp-bottom">
    <div class="mp-progress">
      <span class="mp-time" data-ctime>0:00</span>
      <input class="mp-range" data-seek type="range" min="0" max="1000" value="0" step="1" aria-label="播放进度" />
      <span class="mp-time" data-dur>0:00</span>
    </div>
    <div class="mp-volume"><span data-vol-icon aria-hidden="true">♪</span><input class="mp-range" data-volume type="range" min="0" max="100" value="70" aria-label="音量" /></div>
  </div>
  <div class="mp-error" data-error hidden role="status"></div>
</div>

<style>
  .music-player { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; gap: .5rem .25rem; width: 100%; padding: 1.15rem 1rem; border: 1px solid #ffffff20; border-radius: 1.25rem; background: linear-gradient(135deg, #ffffff08, #ffffff02); backdrop-filter: blur(20px); color: #e4e4e7; }
  .mp-left { min-width: 0; padding-left: .25rem; }
  .mp-kicker { font-size: .58rem; letter-spacing: .15em; text-transform: uppercase; color: #a1a1aa; margin: 0 0 .85rem; }
  .mp-tabs { display: flex; flex-wrap: wrap; gap: .4rem; }
  .mp-tabs button { padding: .4rem .65rem; font-size: .7rem; border: 1px solid #ffffff25; border-radius: 2rem; background: #ffffff06; color: #e4e4e7; cursor: pointer; min-height: 34px; }
  .mp-tabs button:hover { border-color: #ffffff70; background: #ffffff10; }
  .mp-playlist-label { display: block; margin: .9rem 0 .35rem; font-size: .62rem; color: #a1a1aa; letter-spacing: .03em; }
  .mp-playlist-input { display: block; width: 100%; min-width: 0; font: inherit; font-size: .72rem; border: 0; border-bottom: 1px solid #ffffff35; border-radius: 0; padding: .45rem 0; background: transparent; color: #f4f4f5; outline-offset: 4px; }
  .mp-playlist-input:focus { border-bottom-color: #ffffffa0; }
  .mp-playlist-input::placeholder { color: #71717a; font-size: .65rem; }
  .mp-meta { margin-top: 1rem; min-height: 2.6rem; }
  .mp-title { font-size: .85rem; font-weight: 500; line-height: 1.5; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .mp-artist { margin-top: .25rem; font-size: .7rem; color: #a1a1aa; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .mp-controls { display: flex; align-items: center; gap: .6rem; margin-top: .7rem; }
  .mp-btn { display: inline-grid; place-items: center; height: 36px; width: 36px; flex-shrink: 0; border: none; border-radius: 50%; color: #d4d4d8; background: transparent; cursor: pointer; font-size: .85rem; }
  .mp-btn:hover { background: #ffffff12; color: white; }
  .mp-btn-play { border: 1px solid #ffffff55; width: 42px; height: 42px; background: #ffffff08; }
  .mp-disc { position: relative; width: 100%; aspect-ratio: 1; }
  .mp-spectrum { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .mp-spectrum line { stroke: rgba(255, 255, 255, .65); stroke-width: 1.7; stroke-linecap: round; }
  .mp-cover { position: absolute; inset: 17%; border-radius: 50%; overflow: hidden; background: radial-gradient(circle, #27272a, #09090b); box-shadow: 0 0 0 1px #ffffff25, 0 8px 32px #0005; animation: record-spin 28s linear infinite; animation-play-state: paused; }
  .mp-cover img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .is-playing .mp-cover { animation-play-state: running; }
  .mp-bottom { grid-column: 1 / -1; display: flex; align-items: center; gap: 1rem; margin-top: .6rem; }
  .mp-progress { display: flex; align-items: center; gap: .5rem; flex: 1; min-width: 0; }
  .mp-time { font-size: .6rem; font-variant-numeric: tabular-nums; color: #a1a1aa; }
  .mp-range { min-width: 0; width: 100%; height: 3px; accent-color: #e4e4e7; cursor: pointer; }
  .mp-volume { display: flex; align-items: center; gap: .4rem; width: 4rem; color: #a1a1aa; font-size: .75rem; }
  .mp-error { grid-column: 1 / -1; color: #fecaca; font-size: .75rem; line-height: 1.6; margin-top: .5rem; }
  .mp-error[hidden] { display: none; }
  @keyframes record-spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .mp-cover { animation: none; } }
  @media (max-width: 380px) { .music-player { padding: .85rem .6rem; } .mp-bottom { gap: .5rem; } .mp-volume { width: 3rem; } .mp-kicker { letter-spacing: .08em; } }
</style>

<script>
  import {
    fetchPlaylist,
    DEFAULT_PLAYLIST_ID,
    autoQuality,
    QUALITY_OPTIONS,
  } from '../lib/meting';

  import { load, save } from '../lib/storage';
  import { bindMusicVisualizer, unlockMusicVisualizer } from '../lib/audio-spectrum';
  import { bindMediaSession } from '../lib/media-session';

  const fmt = (t) => {
    if (!isFinite(t) || t < 0) t = 0;

    const m = Math.floor(t / 60);
    const s = Math.floor(t % 60);

    return `${m}:${String(s).padStart(2, '0')}`;
  };

  /* =========================================================
     全局播放器
     整个网站始终只有这一个 Audio 实例
     ========================================================= */

  const createGlobalPlayer = () => {
    const audio = new Audio();
    audio.crossOrigin = 'anonymous';
    audio.setAttribute('playsinline', '');

    audio.preload = 'metadata';
    audio.volume = load('music.volume', 0.7);

    const player = {
      audio,

      tracks: [],
      idx: 0,

      playlistId: load(
        'music.playlistId',
        ''
      ),

      mode: load('music.mode', 'list'),
      quality: autoQuality() === '320' ? '320' : load('music.quality', autoQuality()),

      failed: new Set(),

      // 当前页面的 DOM
      root: null,
      ui: null,

      seekLocked: false,
      lastPersist: 0,

      // 是否已经加载过歌单
      playlistLoaded: false,

      // 防止重复请求
      loadingPlaylist: false,
    };

    const modeMap = {
      list: '顺序',
      shuffle: '随机',
      one: '单曲',
    };

    const qualityMap = Object.fromEntries(
      QUALITY_OPTIONS.map((q) => [q.value, q.label])
    );

    /* =========================================================
       UI
       ========================================================= */

    player.setError = (msg) => {
      const errorEl = player.ui?.errorEl;

      if (!errorEl) return;

      if (!msg) {
        errorEl.hidden = true;
        errorEl.textContent = '';
      } else {
        errorEl.hidden = false;
        errorEl.textContent = msg;
      }
    };

    player.renderCurrent = () => {
      const track = player.tracks[player.idx];
      player.mediaSession?.update(track);
      const ui = player.ui;
      if (!ui) return;

      if (!track) {
        ui.titleEl.textContent = '暂无曲目';
        ui.artistEl.textContent = '—';
        ui.coverEl.src = '/avatar.png';
        return;
      }

      ui.titleEl.textContent =
        track.name || '未知曲目';

      ui.artistEl.textContent =
        track.artist || '未知艺术家';

      if (track.pic) {
        ui.coverEl.src = track.pic;
        ui.coverEl.alt = `${track.name || '当前歌曲'} · 封面`;
      } else {
        ui.coverEl.removeAttribute('src');
      }
    };

    player.renderMode = () => {
      if (!player.ui) return;

      player.ui.modeLabel.textContent =
        modeMap[player.mode] || '顺序';
    };

    player.renderQuality = () => {
      if (!player.ui) return;

      player.ui.qualityLabel.textContent =
        qualityMap[player.quality] || '标准';
    };

    player.renderVolume = () => {
      if (!player.ui) return;

      const volume = audio.muted
        ? 0
        : audio.volume;

      player.ui.volEl.value =
        String(Math.round(volume * 100));

      player.ui.volIconEl.textContent =
        audio.muted || audio.volume === 0
          ? '✕'
          : '♪';
    };

    player.renderPlayback = () => {
      const ui = player.ui;

      if (!ui) return;

      player.root?.classList.toggle('is-playing', !audio.paused);

      ui.playIcon.textContent =
        audio.paused ? '▶' : '⏸';

      ui.ctimeEl.textContent =
        fmt(audio.currentTime);

      ui.durEl.textContent =
        fmt(audio.duration);

      if (
        !player.seekLocked &&
        isFinite(audio.duration) &&
        audio.duration > 0
      ) {
        ui.seekEl.value = String(
          Math.round(
            (audio.currentTime / audio.duration) *
              1000
          )
        );
      }
    };

    player.renderAll = () => {
      if (!player.ui) return;

      player.renderCurrent();
      player.renderMode();
      player.renderQuality();
      player.renderVolume();
      player.renderPlayback();

      if (player.ui.playlistInput) {
        player.ui.playlistInput.value =
          player.playlistId || '';
      }
    };

    /* =========================================================
       保存状态
       ========================================================= */

    player.persist = (force = false) => {
      const now = Date.now();

      if (
        !force &&
        now - player.lastPersist < 2500
      ) {
        return;
      }

      player.lastPersist = now;

      if (
        player.tracks.length &&
        isFinite(audio.currentTime)
      ) {
        save('music.pos', {
          id: player.playlistId,
          idx: player.idx,
          t: audio.currentTime,
        });
      }

      save('music.mode', player.mode);
      save('music.quality', player.quality);
      save(
        'music.volume',
        audio.muted ? 0 : audio.volume
      );
    };

    /* =========================================================
       播放控制
       ========================================================= */

    player.play = () => {
      if (!player.tracks.length) { player.setError('歌单正在加载，请稍后点击播放。'); return; }
      player.setError('');
      unlockMusicVisualizer(audio);
      if (audio.error) audio.load();
      const source = audio.src;
      void audio.play().catch((error) => {
        if (audio.src !== source || error?.name === 'AbortError') return;
        player.setError(error?.name === 'NotAllowedError'
          ? '请在网页内点击播放，允许浏览器播放音乐。'
          : '暂时无法播放，请重试或手动切换下一首。');
        player.renderPlayback();
      });
    };

    player.loadAndPlay = (
      index,
      autoplay = false
    ) => {
      if (!player.tracks.length) return;

      player.idx =
        ((index % player.tracks.length) +
          player.tracks.length) %
        player.tracks.length;

      const track =
        player.tracks[player.idx];

      if (!track) return;

      player.renderCurrent();

      /*
       * 只有真正切歌的时候才修改 src。
       * Astro 切页面绝对不会走这里。
       */
      audio.src = track.url;

      if (autoplay) {
        player.play();
      }

      player.persist(true);
    };

    player.next = (auto = false) => {
      if (!player.tracks.length) return;

      if (
        player.mode === 'one' &&
        auto
      ) {
        audio.currentTime = 0;
        player.play();
        return;
      }

      if (player.mode === 'shuffle') {
        const candidates = player.tracks.map((_, index) => index)
          .filter((index) => index !== player.idx && !player.failed.has(index));
        if (!candidates.length && auto) {
          player.setError('暂无其他可播放歌曲，请手动重试。');
          return;
        }
        const nextIndex = candidates.length ? candidates[Math.floor(Math.random() * candidates.length)] : player.idx + 1;

        player.loadAndPlay(
          nextIndex,
          true
        );

        return;
      }

      player.loadAndPlay(
        player.idx + 1,
        true
      );
    };

    player.prev = () => {
      if (!player.tracks.length) return;

      if (audio.currentTime > 3) {
        audio.currentTime = 0;
        return;
      }

      player.loadAndPlay(
        player.idx - 1,
        true
      );
    };

    player.cycleMode = () => {
      const order = [
        'list',
        'shuffle',
        'one',
      ];

      const current =
        order.indexOf(player.mode);

      player.mode =
        order[
          (current + 1) %
            order.length
        ];

      save('music.mode', player.mode);

      player.renderMode();
    };

    /* =========================================================
       歌单
       ========================================================= */

    player.loadPlaylist = async (
      id,
      opts = {}
    ) => {
      const targetId = String(
        id || DEFAULT_PLAYLIST_ID
      ).trim();

      if (player.loadingPlaylist) return;

      player.loadingPlaylist = true;
      player.setError('');

      try {
        /*
         * 判断换歌单之前是否正在播放。
         * 换音质时可以继续自动播放。
         */
        const wasPlaying =
          !audio.paused;

        const list =
          await fetchPlaylist(
            'netease',
            targetId,
            player.quality
          );

        if (!list.length) {
          throw new Error('歌单为空');
        }

        player.playlistId = targetId;
        player.tracks = list;
        player.failed = new Set();

        save(
          'music.playlistId',
          targetId
        );

        let startIdx = 0;
        let startTime = null;

        if (
          opts.keepIndex != null
        ) {
          startIdx = Math.min(
            opts.keepIndex,
            list.length - 1
          );

          startTime =
            opts.keepTime ?? null;
        } else {
          const saved = load(
            'music.pos',
            null
          );

          if (
            saved &&
            String(saved.id) ===
              targetId &&
            Number.isInteger(saved.idx)
          ) {
            startIdx = Math.min(
              Math.max(saved.idx, 0),
              list.length - 1
            );

            startTime =
              saved.t > 2
                ? saved.t
                : null;
          }
        }

        player.idx = startIdx;

        const track =
          list[player.idx];

        player.renderCurrent();

        /*
         * 这里才真正给 Audio 设置歌曲。
         * 页面切换不会重新执行 loadPlaylist，
         * 所以不会重新加载音乐。
         */
        audio.src = track.url;

        if (startTime != null) {
          const applyTime = () => {
            audio.removeEventListener(
              'loadedmetadata',
              applyTime
            );

            if (
              isFinite(audio.duration) &&
              startTime <
                audio.duration - 1
            ) {
              audio.currentTime =
                startTime;
            }
          };

          audio.addEventListener(
            'loadedmetadata',
            applyTime
          );
        }

        player.playlistLoaded = true;

        player.renderAll();

        /*
         * 如果是因为切换音质重新加载歌曲，
         * 保持原来的播放状态。
         */
        if (
          opts.resumePlayback &&
          wasPlaying
        ) {
          player.play();
        }
      } catch (err) {
        console.error(
          '[MusicPlayer] 歌单加载失败',
          err
        );

        player.setError(
          '歌单加载失败，请稍后重试'
        );
      } finally {
        player.loadingPlaylist = false;
      }
    };

    player.setQuality = async (q) => {
      if (q === player.quality) return;

      player.quality = q;

      save(
        'music.quality',
        player.quality
      );

      player.renderQuality();

      await player.loadPlaylist(
        player.playlistId,
        {
          keepIndex: player.idx,
          keepTime:
            audio.currentTime,
          resumePlayback: true,
        }
      );
    };

    /* =========================================================
       Audio 全局事件
       只注册一次
       ========================================================= */

    audio.addEventListener(
      'play',
      () => {
        player.renderPlayback();
      }
    );

    audio.addEventListener(
      'pause',
      () => {
        player.renderPlayback();
        player.persist(true);
      }
    );

    audio.addEventListener(
      'loadedmetadata',
      () => {
        player.renderPlayback();
      }
    );

    audio.addEventListener(
      'timeupdate',
      () => {
        player.renderPlayback();
        player.persist();
      }
    );

    audio.addEventListener(
      'ended',
      () => {
        player.next(true);
      }
    );

    audio.addEventListener(
      'error',
      () => {
        /*
         * Stop on source failures instead of cascading through unavailable tracks.
         * A manual next action or successful retry can resume playback.
         */
        if (!player.tracks.length) {
          return;
        }

        player.failed.add(
          player.idx
        );

        audio.pause();
        player.setError('音频加载失败，已停止自动切歌。请重试或手动切换下一首。');
      }
    );

    /*
     * 刷新/关闭网页时保存。
     * Astro 内部页面切换不会销毁 Audio。
     */
    window.addEventListener(
      'pagehide',
      () => player.persist(true)
    );

    audio.addEventListener('playing', () => { player.failed.delete(player.idx); player.setError(''); });
    player.mediaSession = bindMediaSession(audio, {
      play: () => player.play(), next: () => player.next(false), previous: () => player.prev(),
    });
    return player;
  };

  /* =========================================================
     获取唯一全局播放器
     ========================================================= */

  const getGlobalPlayer = () => {
    if (
      !window.__homeMusicPlayer
    ) {
      window.__homeMusicPlayer =
        createGlobalPlayer();
    }

    return window.__homeMusicPlayer;
  };

  /* =========================================================
     把当前页面 UI 绑定到全局播放器
     页面换了，只执行这里
     ========================================================= */

  const bindPlayerUI = async () => {
    const root =
      document.querySelector(
        '[data-music-player]'
      );

    if (!root) return;

    /*
     * 当前这个 DOM 已经绑定过，
     * 不再重复绑定。
     */
    if (root.__musicBound) {
      return;
    }

    root.__musicBound = true;

    const player =
      getGlobalPlayer();

    const $ = (selector) =>
      root.querySelector(selector);

    const ui = {
      titleEl: $('[data-title]'),
      artistEl: $('[data-artist]'),
      coverEl: $('[data-cover]'),

      ctimeEl: $('[data-ctime]'),
      durEl: $('[data-dur]'),
      seekEl: $('[data-seek]'),

      volEl: $('[data-volume]'),
      volIconEl:
        $('[data-vol-icon]'),

      playBtn: $('[data-play]'),
      playIcon:
        $('[data-play-icon]'),

      prevBtn: $('[data-prev]'),
      nextBtn: $('[data-next]'),

      modeBtn:
        $('[data-mode-btn]'),
      modeLabel:
        $('[data-mode-label]'),

      qualityBtn:
        $('[data-quality-btn]'),
      qualityLabel:
        $('[data-quality-label]'),

      playlistInput:
        $('[data-playlist-input]'),

      errorEl: $('[data-error]'),
    };

    /*
     * 指向当前页面的新 DOM。
     * 旧页面 DOM 会被 Astro 自动移除。
     */
    player.root = root;
    player.ui = ui;
    player.visualizerCleanup?.();
    player.visualizerCleanup = bindMusicVisualizer(root, player.audio);

    /* -------------------------
       播放 / 暂停
       ------------------------- */

    ui.playBtn?.addEventListener(
      'click',
      () => {
        if (player.audio.paused) {
          player.play();
        } else {
          player.audio.pause();
        }
      }
    );

    /* -------------------------
       上一首 / 下一首
       ------------------------- */

    ui.prevBtn?.addEventListener(
      'click',
      () => player.prev()
    );

    ui.nextBtn?.addEventListener(
      'click',
      () => player.next(false)
    );

    /* -------------------------
       播放模式
       ------------------------- */

    ui.modeBtn?.addEventListener(
      'click',
      () => player.cycleMode()
    );

    /* -------------------------
       音质
       ------------------------- */

    ui.qualityBtn?.addEventListener(
      'click',
      () => {
        const order =
          QUALITY_OPTIONS.map(
            (q) => q.value
          );

        const current =
          order.indexOf(
            player.quality
          );

        const nextQuality =
          order[
            (current + 1) %
              order.length
          ];

        player.setQuality(
          nextQuality
        );
      }
    );

    /* -------------------------
       输入歌单 ID + Enter
       ------------------------- */

    ui.playlistInput?.addEventListener(
      'keydown',
      async (e) => {
        if (e.key !== 'Enter') {
          return;
        }

        e.preventDefault();

        const id =
          ui.playlistInput.value.trim();

        if (!id) {
          player.setError(
            '请输入歌单 ID'
          );

          return;
        }

        if (!/^\d+$/.test(id)) {
          player.setError(
            '歌单 ID 格式不正确'
          );

          return;
        }

        ui.playlistInput.blur();

        /*
         * 只有用户主动输入新 ID 时，
         * 才真正换歌单。
         */
        await player.loadPlaylist(
          id,
          {}
        );
        if (player.playlistId === id) save('music.customPlaylist', true);
      }
    );

    /* -------------------------
       进度条
       ------------------------- */

    ui.seekEl?.addEventListener(
      'input',
      () => {
        player.seekLocked = true;

        ui.ctimeEl.textContent =
          fmt(
            (
              Number(
                ui.seekEl.value
              ) / 1000
            ) *
              (
                player.audio
                  .duration || 0
              )
          );
      }
    );

    ui.seekEl?.addEventListener(
      'change',
      () => {
        if (
          player.audio.duration >
          0
        ) {
          player.audio.currentTime =
            (
              Number(
                ui.seekEl.value
              ) / 1000
            ) *
            player.audio.duration;
        }

        player.seekLocked = false;
      }
    );

    /* -------------------------
       音量
       ------------------------- */

    ui.volEl?.addEventListener(
      'input',
      () => {
        const v =
          Number(ui.volEl.value) /
          100;

        player.audio.volume = v;
        player.audio.muted =
          v === 0;

        save('music.volume', v);

        player.renderVolume();
      }
    );

    ui.volIconEl?.addEventListener(
      'click',
      () => {
        player.audio.muted =
          !player.audio.muted;

        player.renderVolume();
      }
    );

    /*
     * 页面刚切换过来：
     * 直接把正在播放的状态显示到新 UI。
     *
     * 这里绝对不能修改 audio.src。
     */
    player.renderAll();

    /*
     * 第一次进入网站时才加载歌单。
     *
     * 后续 Astro 页面切换，
     * playlistLoaded 已经是 true，
     * 因此不会重新 fetch，也不会换歌。
     */
    if (!player.playlistLoaded) {
      const configuredPlaylistId = root.dataset.playlistId || DEFAULT_PLAYLIST_ID;
      const savedDefault = load('music.defaultPlaylistId', '');
      const previousDefault = !load('music.customPlaylist', false) && (
        player.playlistId === savedDefault || ['12309959984', '18401889368'].includes(player.playlistId)
      );
      const initialPlaylistId =
        (previousDefault ? configuredPlaylistId : player.playlistId) || configuredPlaylistId;
      save('music.defaultPlaylistId', configuredPlaylistId);

      player.playlistId =
        initialPlaylistId;

      if (ui.playlistInput) {
        ui.playlistInput.value =
          initialPlaylistId;
      }

      await player.loadPlaylist(
        initialPlaylistId,
        {}
      );
    }
  };

  /* =========================================================
     Astro 页面导航
     ========================================================= */

  document.addEventListener('astro:before-swap', () => {
    const player = window.__homeMusicPlayer;
    player?.visualizerCleanup?.();
    if (player) { player.ui = null; player.root = null; }
  });

  const bootMusicPlayer = () => {
    bindPlayerUI().catch((err) => {
      console.error(
        '[MusicPlayer] UI 绑定失败',
        err
      );
    });
  };

  /*
   * 防止组件脚本再次执行时，
   * 重复添加 astro:page-load。
   */
  if (
    window.__homeMusicPageLoadHandler
  ) {
    document.removeEventListener(
      'astro:page-load',
      window.__homeMusicPageLoadHandler
    );
  }

  window.__homeMusicPageLoadHandler =
    bootMusicPlayer;

  document.addEventListener(
    'astro:page-load',
    window.__homeMusicPageLoadHandler
  );

  /*
   * 首次打开网页。
   */
  bootMusicPlayer();
</script>
