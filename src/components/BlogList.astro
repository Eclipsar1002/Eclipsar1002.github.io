---
import BlogCard from './BlogCard.astro';
import { getEntryDescription, getEntryTitle } from '../utils/content';

interface Post {
	id: string;
	body?: string;
	data: {
		title: string;
		description: string;
		pubDate: Date;
		tags: string[];
		cover?: string;
	};
}

interface Props {
	posts: Post[];
	labels: {
		search: string;
		all: string;
		empty: string;
	};
}

const { posts, labels } = Astro.props;
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort((a, b) => a.localeCompare(b));
const folders = [...new Set(posts.map(post => post.id.split('/').slice(0, -1).join('/')).filter(Boolean))].sort();
---

<div data-blog-filter>
	<div class="mb-8 rounded-lg border border-white/10 bg-white/[0.03] p-4 md:p-5">
		<label class="sr-only" for="blog-search">{labels.search}</label>
		<input
			id="blog-search"
			data-blog-search
			type="search"
			placeholder={labels.search}
			class="w-full rounded-lg border border-white/10 bg-black/30 px-4 py-3 text-sm text-white outline-none transition placeholder:text-zinc-600 focus:border-white/30"
		/>
		{folders.length > 0 && <details class="blog-folder mt-4" data-blog-folder>
			<summary aria-label="按文件夹筛选文章"><span data-folder-label>全部文件夹</span><svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" /></svg></summary>
			<div class="blog-folder-menu" aria-label="文章文件夹">
				<button type="button" data-folder-value="" aria-pressed="true">全部文件夹</button>
				<button type="button" data-folder-value="__root" aria-pressed="false">未分类（根目录）</button>
				{folders.map(folder => <button type="button" data-folder-value={folder} aria-pressed="false">{folder}</button>)}
			</div>
		</details>}
		<div class="mt-4 flex flex-wrap gap-2">
			<button
				type="button"
				data-blog-tag="all"
				class="rounded-full border border-white/30 bg-white px-4 py-2 text-xs font-medium text-black transition"
			>
				{labels.all}
			</button>
			{tags.map((tag) => (
				<button
					type="button"
					data-blog-tag={tag}
					class="rounded-full border border-white/10 bg-white/[0.04] px-4 py-2 text-xs font-medium text-zinc-300 transition hover:border-white/30 hover:text-white"
				>
					#{tag}
				</button>
			))}
		</div>
	</div>

	<div data-blog-list>
		{posts.map((post) => (
			<div
				data-blog-card
				data-folder={post.id.split('/').slice(0, -1).join('/')}
				data-search={`${getEntryTitle(post)} ${getEntryDescription(post)} ${post.data.tags.join(' ')}`.toLowerCase()}
				data-tags={post.data.tags.join('\u001f').toLowerCase()}
			>
				<BlogCard post={post} />
			</div>
		))}
	</div>

	<p data-blog-empty hidden class="rounded-lg border border-white/10 bg-white/[0.03] p-6 text-sm text-zinc-400">
		{labels.empty}
	</p>
</div>

<style>
	.blog-folder { position: relative; width: fit-content; max-width: 100%; color: #d4d4d8; font-size: .875rem; }
	.blog-folder summary { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; padding: .6rem .85rem; border: 1px solid #ffffff26; border-radius: .65rem; background: #18181bd9; cursor: pointer; list-style: none; transition: background .15s, border-color .15s; }
	.blog-folder summary::-webkit-details-marker { display: none; }
	.blog-folder summary:hover, .blog-folder[open] summary { background: #202023ed; border-color: #ffffff40; }
	.blog-folder summary svg { flex-shrink: 0; transition: transform .15s; }
	.blog-folder[open] summary svg { transform: rotate(180deg); }
	.blog-folder-menu { position: absolute; z-index: 30; top: calc(100% + .5rem); left: 0; min-width: 100%; width: max-content; max-width: min(22rem, calc(100vw - 5rem)); max-height: 18rem; overflow: auto; scrollbar-width: none; padding: .35rem; border: 1px solid #ffffff24; border-radius: .75rem; background: #151517f5; backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px); box-shadow: 0 20px 60px #0008; }
	.blog-folder-menu::-webkit-scrollbar { display: none; }
	.blog-folder-menu button { display: block; width: 100%; padding: .6rem .8rem; border-radius: .4rem; text-align: left; overflow-wrap: anywhere; color: #d4d4d8; background: transparent; cursor: pointer; transition: background .15s, color .15s; }
	.blog-folder-menu button:hover, .blog-folder-menu button[aria-pressed="true"] { background: #ffffff12; color: #fafafa; }
	.blog-folder :focus-visible { outline: 1px solid #ffffff70; outline-offset: 2px; }
</style>

<script>
	function mountBlogFilters() {
	document.querySelectorAll('[data-blog-filter]').forEach((root) => {
		if (root.hasAttribute('data-filter-bound')) return;
		root.setAttribute('data-filter-bound', '');
		const search = root.querySelector<HTMLInputElement>('[data-blog-search]');
		const cards = [...root.querySelectorAll<HTMLElement>('[data-blog-card]')];
		const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-blog-tag]')];
		const empty = root.querySelector<HTMLElement>('[data-blog-empty]');
		const folder = root.querySelector<HTMLDetailsElement>('[data-blog-folder]');
		const folderOptions = [...root.querySelectorAll<HTMLButtonElement>('[data-folder-value]')];
		let selectedFolder = '';
		let activeTag = 'all';

		const setButtonState = () => {
			buttons.forEach((button) => {
				const isActive = button.dataset.blogTag === activeTag;
				button.classList.toggle('border-white/30', isActive);
				button.classList.toggle('bg-white', isActive);
				button.classList.toggle('text-black', isActive);
				button.classList.toggle('border-white/10', !isActive);
				button.classList.toggle('bg-white/[0.04]', !isActive);
				button.classList.toggle('text-zinc-300', !isActive);
			});
		};

		const filterCards = () => {
			const query = search?.value.trim().toLowerCase() ?? '';
			let visibleCount = 0;

			cards.forEach((card) => {
				const searchableText = card.dataset.search ?? '';
				const tagList = (card.dataset.tags ?? '').split('\u001f').filter(Boolean);
				const matchesQuery = !query || searchableText.includes(query);
				const matchesTag = activeTag === 'all' || tagList.includes(activeTag.toLowerCase());
				const cardFolder = card.dataset.folder || '';
				const matchesFolder = !selectedFolder || (selectedFolder === '__root' ? !cardFolder : cardFolder === selectedFolder || cardFolder.startsWith(`${selectedFolder}/`));
				const isVisible = matchesQuery && matchesTag && matchesFolder;

				card.hidden = !isVisible;
				if (isVisible) visibleCount += 1;
			});

			if (empty) empty.hidden = visibleCount > 0;
			setButtonState();
		};

		search?.addEventListener('input', filterCards);
		folderOptions.forEach(option => option.addEventListener('click', () => {
			selectedFolder = option.dataset.folderValue || '';
			const label = folder?.querySelector('[data-folder-label]');
			if (label) label.textContent = option.textContent;
			folderOptions.forEach(item => item.setAttribute('aria-pressed', String(item === option)));
			if (folder) { folder.open = false; folder.querySelector('summary')?.focus(); }
			filterCards();
		}));
		if (folder) {
			const onOutside = (event: PointerEvent) => { if (event.target instanceof Node && !folder.contains(event.target)) folder.open = false; };
			document.addEventListener('pointerdown', onOutside);
			document.addEventListener('astro:before-swap', () => document.removeEventListener('pointerdown', onOutside), { once: true });
			folder.addEventListener('keydown', event => {
				if (event.key === 'Escape') { folder.open = false; folder.querySelector('summary')?.focus(); }
				if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
					event.preventDefault(); folder.open = true;
					const current = folderOptions.indexOf(document.activeElement as HTMLButtonElement);
					const next = current < 0 ? (event.key === 'ArrowDown' ? 0 : folderOptions.length - 1) : (current + (event.key === 'ArrowDown' ? 1 : -1) + folderOptions.length) % folderOptions.length;
					folderOptions[next]?.focus();
				}
			});
		}
		buttons.forEach((button) => {
			button.addEventListener('click', () => {
				activeTag = button.dataset.blogTag ?? 'all';
				filterCards();
			});
		});

		filterCards();
	});
	}
	mountBlogFilters();
	document.addEventListener('astro:page-load', mountBlogFilters);
</script>
