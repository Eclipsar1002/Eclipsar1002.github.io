<dialog class="image-lightbox" aria-label="图片预览" data-image-lightbox>
  <div class="lightbox-toolbar">
    <span data-lightbox-count aria-live="polite"></span>
    <div>
      <a data-lightbox-original target="_blank" rel="noopener noreferrer">查看原图 ↗</a>
      <button type="button" data-lightbox-close aria-label="关闭图片预览">×</button>
    </div>
  </div>
  <button type="button" class="lightbox-prev" data-lightbox-prev aria-label="上一张图片">‹</button>
  <figure>
    <img data-lightbox-image alt="" draggable="false" />
    <figcaption data-lightbox-caption></figcaption>
    <p data-lightbox-error role="status" hidden>图片加载失败，可以点击右上角查看原图。</p>
  </figure>
  <button type="button" class="lightbox-next" data-lightbox-next aria-label="下一张图片">›</button>
</dialog>

<script>
  function mountLightbox() {
    const dialog = document.querySelector<HTMLDialogElement>('[data-image-lightbox]');
    if (!dialog || dialog.dataset.bound) return;
    dialog.dataset.bound = 'true';
    const image = dialog.querySelector<HTMLImageElement>('[data-lightbox-image]')!;
    const count = dialog.querySelector<HTMLElement>('[data-lightbox-count]')!;
    const caption = dialog.querySelector<HTMLElement>('[data-lightbox-caption]')!;
    const original = dialog.querySelector<HTMLAnchorElement>('[data-lightbox-original]')!;
    const error = dialog.querySelector<HTMLElement>('[data-lightbox-error]')!;
    const prev = dialog.querySelector<HTMLButtonElement>('[data-lightbox-prev]')!;
    const next = dialog.querySelector<HTMLButtonElement>('[data-lightbox-next]')!;
    const controller = new AbortController();
    const options = { signal: controller.signal };
    let images: HTMLImageElement[] = [];
    let index = 0;
    let trigger: HTMLElement | null = null;
    let previousOverflow = '';
    let swipe: { x: number; y: number } | null = null;

    // Images linking to another page retain their original navigation.
    function eligible(img: HTMLImageElement) {
      const link = img.closest('a');
      return !link || link.href === img.src || link.href === img.currentSrc ||
        /\.(avif|gif|jpe?g|png|svg|webp)(?:[?#]|$)/i.test(link.href);
    }
    function prepareImages() {
      document.querySelectorAll<HTMLImageElement>('[data-lightbox-gallery] img').forEach(img => {
        if (!eligible(img)) return;
        img.classList.add('lightbox-trigger');
        const control = img.closest('a') || img;
        control.setAttribute('aria-haspopup', 'dialog');
        if (control === img) {
          img.tabIndex = 0;
          img.setAttribute('role', 'button');
          img.setAttribute('aria-label', img.alt ? `放大图片：${img.alt}` : '放大图片');
        }
      });
    }
    function show(offset = 0) {
      index = (index + offset + images.length) % images.length;
      const source = images[index];
      const link = source.closest('a');
      const url = link?.href || source.currentSrc || source.src;
      error.hidden = true;
      image.hidden = false;
      image.alt = source.alt;
      image.src = url;
      original.href = url;
      caption.textContent = source.alt;
      count.textContent = `${index + 1} / ${images.length}`;
      prev.hidden = next.hidden = images.length < 2;
    }
    function open(source: HTMLImageElement) {
      const gallery = source.closest('[data-lightbox-gallery]')!;
      images = [...gallery.querySelectorAll<HTMLImageElement>('img')].filter(eligible);
      index = images.indexOf(source);
      trigger = source.closest('a') || source;
      show();
      previousOverflow = document.documentElement.style.overflow;
      document.documentElement.style.overflow = 'hidden';
      dialog!.showModal();
    }
    function restore() {
      document.documentElement.style.overflow = previousOverflow;
      image.removeAttribute('src');
      trigger?.focus({ preventScroll: true });
      images = [];
      swipe = null;
    }
    document.addEventListener('click', event => {
      if (!(event.target instanceof HTMLImageElement) || !event.target.closest('[data-lightbox-gallery]') || !eligible(event.target)) return;
      if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      event.stopPropagation();
      open(event.target);
    }, { ...options, capture: true });
    document.addEventListener('keydown', event => {
      if (dialog!.open) {
        if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
          event.preventDefault();
          show(event.key === 'ArrowLeft' ? -1 : 1);
        }
      } else if ((event.key === 'Enter' || event.key === ' ') && event.target instanceof HTMLImageElement && event.target.classList.contains('lightbox-trigger')) {
        event.preventDefault();
        open(event.target);
      }
    }, options);
    dialog.querySelector('[data-lightbox-close]')!.addEventListener('click', () => dialog.close(), options);
    prev.addEventListener('click', () => show(-1), options);
    next.addEventListener('click', () => show(1), options);
    dialog.addEventListener('click', event => {
      if (event.target === dialog || event.target === dialog.querySelector('figure')) dialog.close();
    }, options);
    dialog.addEventListener('close', restore, options);
    image.addEventListener('error', () => { image.hidden = true; error.hidden = false; }, options);
    dialog.addEventListener('touchstart', event => {
      swipe = event.touches.length === 1 ? { x: event.touches[0].clientX, y: event.touches[0].clientY } : null;
    }, { ...options, passive: true });
    dialog.addEventListener('touchend', event => {
      if (!swipe || event.touches.length || !event.changedTouches.length) { swipe = null; return; }
      const dx = event.changedTouches[0].clientX - swipe.x;
      const dy = event.changedTouches[0].clientY - swipe.y;
      if (Math.abs(dx) > 55 && Math.abs(dx) > Math.abs(dy) * 1.4) show(dx < 0 ? 1 : -1);
      swipe = null;
    }, { ...options, passive: true });
    dialog.addEventListener('touchcancel', () => { swipe = null; }, options);
    prepareImages();
    const observer = new MutationObserver(prepareImages);
    const main = document.querySelector('main');
    if (main) observer.observe(main, { childList: true, subtree: true });
    document.addEventListener('astro:before-swap', () => {
      if (dialog.open) { dialog.close(); restore(); }
      observer.disconnect();
      controller.abort();
    }, { once: true });
  }
  mountLightbox();
  document.addEventListener('astro:page-load', mountLightbox);
</script>

<style is:global>
  .lightbox-trigger { cursor: zoom-in; }
  .lightbox-trigger:focus-visible { outline: 2px solid #d4d4d8; outline-offset: 4px; }
  .image-lightbox { position: fixed; inset: 0; width: 100%; max-width: none; height: 100%; height: 100dvh; max-height: none; margin: 0; padding: 0; border: 0; background: #09090bf2; color: #e4e4e7; overflow: hidden; }
  .image-lightbox::backdrop { background: #09090b; }
  .image-lightbox[open] { display: grid; grid-template-columns: 4rem minmax(0, 1fr) 4rem; align-items: center; animation: lightbox-appear 160ms ease-out; }
  .lightbox-toolbar { position: absolute; top: 0; left: 0; right: 0; z-index: 1; display: flex; align-items: center; justify-content: space-between; padding: max(1rem, env(safe-area-inset-top)) max(1.25rem, env(safe-area-inset-right)) 1rem max(1.25rem, env(safe-area-inset-left)); font-size: .85rem; color: #a1a1aa; }
  .lightbox-toolbar > div { display: flex; align-items: center; gap: 1.25rem; }
  .image-lightbox button { border: 1px solid #ffffff20; background: #ffffff08; border-radius: 999px; width: 2.75rem; height: 2.75rem; color: #e4e4e7; cursor: pointer; font-size: 1.8rem; line-height: 1; justify-self: center; }
  .image-lightbox button:hover { background: #ffffff18; }
  .image-lightbox button:focus-visible, .image-lightbox a:focus-visible { outline: 2px solid #d4d4d8; outline-offset: 4px; }
  .image-lightbox [hidden] { display: none !important; }
  .image-lightbox figure { grid-column: 2; grid-row: 1; margin: 0; text-align: center; min-width: 0; }
  .image-lightbox figure img { display: block; width: auto; height: auto; max-width: 100%; max-height: calc(100dvh - 12rem); object-fit: contain; margin: auto; border-radius: .4rem; }
  .image-lightbox figcaption { margin-top: 1rem; max-height: 3rem; overflow: auto; color: #a1a1aa; font-size: .85rem; overflow-wrap: anywhere; }
  .lightbox-prev { grid-column: 1; grid-row: 1; }
  .lightbox-next { grid-column: 3; grid-row: 1; }
  @keyframes lightbox-appear { from { opacity: 0; } to { opacity: 1; } }
  @media (max-width: 640px) {
    .image-lightbox[open] { grid-template-columns: .75rem minmax(0, 1fr) .75rem; }
    .image-lightbox .lightbox-prev, .image-lightbox .lightbox-next { position: absolute; bottom: max(1.5rem, env(safe-area-inset-bottom)); }
    .image-lightbox .lightbox-prev { left: calc(50% - 4rem); }
    .image-lightbox .lightbox-next { right: calc(50% - 4rem); }
  }
  @media (prefers-reduced-motion: reduce) { .image-lightbox[open] { animation: none; } }
</style>
