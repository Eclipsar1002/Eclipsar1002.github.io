---
const poems = [
  { verse: '且将新火试新茶，诗酒趁年华。', author: '苏轼', title: '望江南·超然台作' },
  { verse: '行到水穷处，坐看云起时。', author: '王维', title: '终南别业' },
  { verse: '人闲桂花落，夜静春山空。', author: '王维', title: '鸟鸣涧' },
  { verse: '明月松间照，清泉石上流。', author: '王维', title: '山居秋暝' },
  { verse: '夜阑卧听风吹雨，铁马冰河入梦来。', author: '陆游', title: '十一月四日风雨大作·其二' },
  { verse: '小楼一夜听春雨，深巷明朝卖杏花。', author: '陆游', title: '临安春雨初霁' },
  { verse: '山中何事？松花酿酒，春水煎茶。', author: '张可久', title: '人月圆·山中书事' },
  { verse: '疏影横斜水清浅，暗香浮动月黄昏。', author: '林逋', title: '山园小梅·其一' },
  { verse: '星垂平野阔，月涌大江流。', author: '杜甫', title: '旅夜书怀' },
  { verse: '长风破浪会有时，直挂云帆济沧海。', author: '李白', title: '行路难·其一' },
  { verse: '此中有真意，欲辨已忘言。', author: '陶渊明', title: '饮酒·其五' },
  { verse: '掬水月在手，弄花香满衣。', author: '于良史', title: '春山夜月' },
  { verse: '落霞与孤鹜齐飞，秋水共长天一色。', author: '王勃', title: '滕王阁序' },
  { verse: '浮云一别后，流水十年间。', author: '韦应物', title: '淮上喜会梁川故人' },
  { verse: '山光悦鸟性，潭影空人心。', author: '常建', title: '题破山寺后禅院' },
  { verse: '满船清梦压星河。', author: '唐珙', title: '题龙阳县青草湖' },
  { verse: '松月生夜凉，风泉满清听。', author: '孟浩然', title: '宿业师山房期丁大不至' },
  { verse: '曲终人不见，江上数峰青。', author: '钱起', title: '省试湘灵鼓瑟' },
  { verse: '微微风簇浪，散作满河星。', author: '查慎行', title: '舟夜书所见' },
];
const first = poems[0];
---

<div class="poem" data-random-poem data-poems={JSON.stringify(poems)}>
  <button class="poem-change" type="button" aria-label="换一句诗词" title="点击换一句诗词">
    <span class="poem-verse" data-poem-verse>{first.verse}</span>
    <span class="poem-source" data-poem-source>— {first.author}《{first.title}》</span>
  </button>
</div>

<script>
  function mountPoems() {
    document.querySelectorAll<HTMLElement>('[data-random-poem]').forEach((root) => {
      if (root.dataset.bound) return;
      root.dataset.bound = 'true';
      const poems: Array<{ verse: string; author: string; title: string }> = JSON.parse(root.dataset.poems || '[]');
      if (!poems.length) return;
      const button = root.querySelector('button')!;
      let request: AbortController | undefined;
      let disposed = false;
      function show(poem: { verse: string; author: string; title: string }) {
        root.querySelector('[data-poem-verse]')!.textContent = poem.verse;
        root.querySelector('[data-poem-source]')!.textContent = `— ${poem.author}《${poem.title}》`;
      }
      function localPoem() {
        const current = root.querySelector('[data-poem-verse]')!.textContent;
        const candidates = poems.filter((poem) => poem.verse !== current);
        show(candidates[Math.floor(Math.random() * candidates.length)] || poems[0]);
      }
      async function change() {
        request?.abort();
        const controller = new AbortController();
        request = controller;
        const previous = root.querySelector('[data-poem-verse]')!.textContent;
        button.setAttribute('aria-busy', 'true');
        const timer = setTimeout(() => controller.abort(), 6000);
        try {
          const response = await fetch('https://v1.jinrishici.com/all.json', {
            signal: controller.signal, cache: 'no-store', referrerPolicy: 'no-referrer',
          });
          if (!response.ok) throw new Error('Poetry service unavailable');
          const data = await response.json();
          if (disposed || request !== controller || !root.isConnected) return;
          if (typeof data.content !== 'string' || !data.content.trim() || data.content.length > 120 ||
            typeof data.author !== 'string' || !data.author.trim() || data.author.length > 60 ||
            typeof data.origin !== 'string' || !data.origin.trim() || data.origin.length > 160) throw new Error('Invalid poetry response');
          if (data.content.trim() === previous) localPoem();
          else show({ verse: data.content.trim(), author: data.author.trim(), title: data.origin.trim() });
        } catch {
          // Only the active request may change the verse, including after a timeout.
          if (!disposed && request === controller && root.isConnected) localPoem();
        }
        finally {
          clearTimeout(timer);
          if (request === controller) button.removeAttribute('aria-busy');
        }
      }
      void change();
      button.addEventListener('click', () => { void change(); });
      document.addEventListener('astro:before-swap', () => { disposed = true; request?.abort(); }, { once: true });
    });
  }
  mountPoems();
  document.addEventListener('astro:page-load', mountPoems);
</script>

<style>
  .poem { position: relative; top: 1.5rem; color: #fff; text-align: center; }
  .poem-change { display: block; width: 100%; padding: .65rem .25rem; border: 0; border-radius: .4rem; background: transparent; color: inherit; cursor: pointer; font-family: 'Kaiti SC', 'STKaiti', 'KaiTi', 'Songti SC', 'SimSun', serif; font-weight: 400; text-shadow: 0 1px 8px #0006; }
  .poem-change:focus-visible { outline: 1px solid #ffffffb3; outline-offset: 5px; }
  .poem-verse { display: block; font-size: clamp(1rem, 1.8vw, 1.2rem); line-height: 2; letter-spacing: .08em; text-wrap: balance; }
  .poem-source { display: block; margin-top: .4rem; padding-right: .25rem; font-size: .72rem; font-weight: 400; line-height: 1.8; letter-spacing: .06em; text-align: right; opacity: .8; }
  .poem-change:hover .poem-verse { text-shadow: 0 0 12px #ffffff45, 0 1px 8px #0009; }
</style>
