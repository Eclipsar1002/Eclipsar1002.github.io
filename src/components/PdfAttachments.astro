---
interface Props { files?: Array<{ name: string; file: string }> }
const { files = [] } = Astro.props;
// Only serve site files or HTTPS links; never render executable URL schemes.
const attachments = files.filter(({ file }) => file.startsWith('/') && !file.startsWith('//') || file.startsWith('https://'));
function previewUrl(file: string) {
  try {
    const url = new URL(file, Astro.url);
    url.hash = 'view=Fit';
    return file.startsWith('/') ? `${url.pathname}${url.search}${url.hash}` : url.href;
  } catch { return file; }
}
---

{attachments.length > 0 && <section class="mt-8 rounded-lg border border-white/15 bg-white/5 p-5" aria-label="PDF 附件">
  <h2 class="text-lg font-medium text-white">PDF 附件</h2>
  <ul class="mt-4 space-y-4">
    {attachments.map(({ name, file }, index) => <li class="pdf-attachment">
      <div class="pdf-attachment-heading">
        <span class="break-words text-zinc-300">{name || 'PDF 附件'}</span>
        <span class="flex gap-4 text-sm text-white">
          <a href={file} target="_blank" rel="noopener noreferrer" data-astro-reload>打开 PDF ↗</a>
          <a href={file} download data-astro-reload>下载</a>
        </span>
      </div>
      <details class="pdf-preview">
        <summary aria-controls={`pdf-preview-${index}`}>页面内预览</summary>
        <iframe id={`pdf-preview-${index}`} src={previewUrl(file)} title={`${name || 'PDF 附件'}预览`} loading="lazy"></iframe>
      </details>
    </li>)}
  </ul>
</section>}

<style>
  .pdf-attachment { min-width: 0; }
  .pdf-attachment-heading { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .75rem; }
  .pdf-preview { margin-top: .75rem; }
  .pdf-preview summary { width: fit-content; color: #d4d4d8; cursor: pointer; font-size: .8rem; }
  .pdf-preview summary:hover { color: white; }
  .pdf-preview iframe { display: block; width: 100%; height: min(82svh, 960px); min-height: 560px; margin-top: .75rem; border: 1px solid #ffffff20; border-radius: .375rem; background: #fff; }
  @media (max-width: 640px) { .pdf-preview iframe { height: 80svh; min-height: 460px; } }
</style>
